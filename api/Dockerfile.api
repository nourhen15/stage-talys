FROM python:3.12-slim

WORKDIR /app

# On copie et installe les dépendances d'abord (avant le code) : Docker met en cache
# cette étape, donc si tu modifies juste main.py plus tard, le rebuild sera bien
# plus rapide (pas besoin de réinstaller toutes les bibliothèques à chaque fois)
COPY requirements.txt .
RUN pip install --no-cache-dir --timeout=120 --retries=10 -r requirements.txt
COPY main.py .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]